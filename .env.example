# Copy this file to .env and fill in your values.
# .env is gitignored and should never be committed.

OPENAI_API_KEY=sk-...
SCAN_MODEL=gpt-5.4
SCAN_BATCH_SIZE=10

# OpenRouter (alternative to OpenAI). When OPENAI_BASE_URL is set the labeller
# uses chat-completions instead of OpenAI's /responses endpoint.
OPENROUTER_API_KEY=sk-or-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
