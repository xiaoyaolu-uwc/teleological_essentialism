# secrets
.env

# python
__pycache__/
*.pyc
*.pyo

# mac
.DS_Store
**/.DS_Store

# editor
.vscode/
*.swp

# eval results (generated outputs, not source)
eval/results/**/*.csv

# relabel report (generated binaries/temp, not source)
eval/relabel_report/*.docx
eval/relabel_report/*.pdf
eval/relabel_report/*.jpg
eval/relabel_report/*.tmp
eval/relabel_report/.~lock.*
eval/relabel_report/*.csv

# BERT checkpoints (weights are large binaries, not source; keep metadata.json)
models/checkpoints/*/*
!models/checkpoints/*/metadata.json

# local Claude Code tool state, not project history
.claude/settings.local.json
.claude/scheduled_tasks.lock
