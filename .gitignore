# secrets
.env

# python
__pycache__/
*.pyc
*.pyo

# mac
.DS_Store
**/.DS_Store

# editor
.vscode/
*.swp

# generated outputs, not source -- with two deliberate exceptions below
evaluation/results/**/*.csv
archive/results/**/*.csv

# ...except the per-row predictions, which ARE committed: every published
# confidence claim is recomputed from them, so they must be reproducible
# without a GPU. See evaluation/README.md.
!evaluation/results/proportions/per_row_predictions.csv
!evaluation/results/proportions/per_row_predictions_ens2.csv

# relabel report (generated binaries/temp, not source)
archive/relabel_report/*.docx
archive/relabel_report/*.pdf
archive/relabel_report/*.jpg
archive/relabel_report/*.tmp
archive/relabel_report/.~lock.*
archive/relabel_report/*.csv

# BERT checkpoints (weights are large binaries, not source; keep metadata.json)
models/checkpoints/*/*
!models/checkpoints/*/metadata.json

# local Claude Code tool state, not project history
.claude/settings.local.json
.claude/scheduled_tasks.lock

# local Python virtualenv for running inference off-cluster
.venv/

# scanning corpus: bulk-downloaded raw OCR (~2GB for 2,665 volumes).
# Regenerable from corpus/bhl/derived/scan_pool.csv via corpus/download_texts.py,
# so the selection is versioned and the payload is not.
data/texts/scan_raw/
data/texts/download.log

# per-run resume manifest; rewritten every few seconds while a download runs.
# Commit a frozen copy once the run finishes if you want failure provenance.
data/texts/scan_download_status.csv

# email drafts: personal correspondence, not project source
*_email.md
handoff_email.md
archive/relabel_report/email_draft.md

# scanning corpus intermediates. Regenerable from the versioned pipeline
# (scan_pool.csv -> download_texts.py -> clean_scan_texts.py ->
# build_scan_sentences.py), so the selection is committed and the bulk is not.
data/texts/scan_clean/
data/scan/sentences/
data/texts/local_pipeline.log
data/texts/push.log
data/scan/validation_run.log
