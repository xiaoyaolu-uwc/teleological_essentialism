# secrets
.env

# python
__pycache__/
*.pyc
*.pyo

# mac
.DS_Store
**/.DS_Store

# editor
.vscode/
*.swp

# generated outputs, not source -- with two deliberate exceptions below
evaluation/results/**/*.csv
archive/results/**/*.csv

# ...except the per-row predictions, which ARE committed: every published
# confidence claim is recomputed from them, so they must be reproducible
# without a GPU. See evaluation/README.md.
!evaluation/results/proportions/per_row_predictions.csv
!evaluation/results/proportions/per_row_predictions_ens2.csv

# relabel report (generated binaries/temp, not source)
archive/relabel_report/*.docx
archive/relabel_report/*.pdf
archive/relabel_report/*.jpg
archive/relabel_report/*.tmp
archive/relabel_report/.~lock.*
archive/relabel_report/*.csv

# BERT checkpoints (weights are large binaries, not source; keep metadata.json)
models/checkpoints/*/*
!models/checkpoints/*/metadata.json

# local Claude Code tool state, not project history
.claude/settings.local.json
.claude/scheduled_tasks.lock

# local Python virtualenv for running inference off-cluster
.venv/
